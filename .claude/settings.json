{
  "permissions": {
    "allow": [
      "Bash(bash scripts/check-versions.sh)",
      "Bash(bash scripts/check-plugin-version-bump.sh:*)",
      "Bash(bash scripts/check-language-anchors.sh)",
      "Bash(bash scripts/check-subagent-model.sh)",
      "Bash(bash scripts/check-templates.sh)",
      "Bash(shellcheck:*)",
