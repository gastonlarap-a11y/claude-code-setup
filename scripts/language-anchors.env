# Single source of truth for the language-anchor literals rewritten by the installers
# and asserted by CI. Consumers: install.sh (sources this file), install.ps1 (regex
# parse), scripts/check-language-anchors.sh (CI guard). If either anchor stops matching
# its source file, CI fails before the installers can silently stop rewriting.
CLAUDE_MD_LANGUAGE_ANCHOR='Always answer **in Spanish**'
SETTINGS_LANGUAGE_ANCHOR='"language": "spanish"'
