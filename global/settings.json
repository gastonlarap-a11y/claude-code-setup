{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go mod tidy)",
      "Bash(gofmt:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew lint:*)",
      "Bash(task package:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(claude plugin list:*)",
      "Bash(claude plugin marketplace list:*)",
      "Bash(claude mcp list:*)",
      "Bash(wc -l:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(kubectl delete:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.env)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets.env)"
    ]
  },
  "model": "fable",
  "fallbackModel": ["claude-opus-4-8", "claude-sonnet-5"],
  "language": "spanish",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "sandbox": {
    "enabled": true,
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" }
      ],
      "envVars": [
        { "name": "CONTEXT7_API_KEY", "mode": "deny" }
      ]
    },
    "excludedCommands": ["docker *", "gh *", "kubectl *"]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/filter-test-output.sh\""
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"$HOME/.claude/hooks/guard-git-push.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/format-on-edit.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "expo@claude-plugins-official": false,
    "nestjs@gaston-plugins": false,
    "go@gaston-plugins": false,
    "android-kotlin@gaston-plugins": false,
    "react-nextjs@gaston-plugins": false,
    "flutter@gaston-plugins": false,
    "react-native@gaston-plugins": false,
    "dotnet@gaston-plugins": false,
    "api-design@gaston-plugins": false,
    "bots@gaston-plugins": false,
    "realtime@gaston-plugins": false,
    "background-jobs@gaston-plugins": false,
    "ux@gaston-plugins": false
  },
  "effortLevel": "high",
  "theme": "dark"
}
