{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go mod tidy)",
      "Bash(gofmt:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew lint:*)",
      "Bash(task package:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(claude plugin list:*)",
      "Bash(claude plugin marketplace list:*)",
      "Bash(claude mcp list:*)",
      "Bash(wc -l:*)",
      "Read",
      "Edit",
      "Write",
      "MultiEdit"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(kubectl delete:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.env)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets.env)",
      "Edit(.git/**)",
      "Edit(**/package-lock.json)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/yarn.lock)",
      "Edit(**/go.sum)",
      "Bash(*DROP DATABASE*:*)",
      "Bash(*DROP TABLE*:*)"
    ]
  },
  "model": "opus[1m]",
  "fallbackModel": ["claude-opus-5", "claude-sonnet-5"],
  "language": "spanish",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "sandbox": {
    "enabled": true,
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" }
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "pub.dev",
        "storage.googleapis.com",
        "repo.maven.apache.org",
        "dl.google.com",
        "api.nuget.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    },
    "excludedCommands": ["docker *", "gh *", "kubectl *"]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/filter-test-output.sh\""
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"$HOME/.claude/hooks/guard-git-push.sh\""
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"$HOME/.claude/hooks/guard-git-add-all.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/guard-shell-edit.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/format-on-edit.sh\""
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/audit-config-change.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": false,
    "csharp-lsp@claude-plugins-official": false,
    "expo@claude-plugins-official": false,
    "nestjs@dev-plugins": false,
    "go@dev-plugins": false,
    "android-kotlin@dev-plugins": false,
    "react-nextjs@dev-plugins": false,
    "flutter@dev-plugins": false,
    "react-native@dev-plugins": false,
    "dotnet@dev-plugins": false,
    "api-design@dev-plugins": false,
    "bots@dev-plugins": false,
    "realtime@dev-plugins": false,
    "background-jobs@dev-plugins": false,
    "ux@dev-plugins": false
  },
  "effortLevel": "high",
  "theme": "dark"
}
